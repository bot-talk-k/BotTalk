# ============================================================================
# BotTalk 环境变量配置 / Environment Variables Configuration
# ============================================================================
# 复制此文件为 .env 并修改 / Copy this file to .env and edit
#   cp .env.example .env
# ============================================================================

# ── 服务器配置 / Server Configuration ───────────────────────────────────────

# [可选/Optional] 服务监听端口 / Server listening port
# 默认值 / Default: 3000
PORT=3000

# [必填/Required] 对外访问的基础 URL / Public-facing base URL
# 用于生成二维码、API 示例等 / Used for QR codes, API examples, etc.
# 自部署时改为你的域名 / Change to your domain when self-hosting
# 如果通过反向代理（Nginx 等）加了路径前缀，也要写进去
# If you use a reverse proxy with a path prefix, include it here
# 示例 / Examples:
#   https://yourdomain.com
#   https://yourdomain.com/bottalk
BASE_URL=https://bot-talk.com

# ── 安全配置 / Security Configuration ──────────────────────────────────────

# [可选/Optional] Session 签名密钥 / Session signing secret
# 留空则每次启动自动生成随机密钥（重启后已登录的 session 会失效）
# If empty, a random secret is generated on each startup
# (existing sessions will be invalidated on restart)
# 建议生产环境设置固定值 / Recommended to set a fixed value in production
# 生成方法 / Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=your-random-secret-here

# ── 时区配置 / Timezone Configuration ──────────────────────────────────────

# [可选/Optional] 容器时区 / Container timezone
# 默认值 / Default: Asia/Shanghai
# 影响定时提醒的触发时间 / Affects scheduled reminder trigger times
TZ=Asia/Shanghai
