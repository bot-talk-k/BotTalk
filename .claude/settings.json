      "Bash(*)",
      "PowerShell(*)",
      "WebSearch",
      "WebFetch(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Agent(*)",
      "AskUserQuestion(*)",
      "EnterPlanMode",
      "ExitPlanMode",
      "TodoWrite(*)",
      "Read(//c/Users/thoma/.ssh/**)",
      "Bash(ssh rn *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(./deploy.sh *)",
      "Bash(bash deploy.sh *)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run lint\\:fix:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
