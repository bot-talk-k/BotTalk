    "additionalDirectories": [
      "c:\\Users\\thoma\\Documents\\bottalk\\.claude"
    ]
  },
  "availableModels": [
    "sonnet",
    "haiku",
    "opus",
    "qwen3.6-plus",
    "qwen3.5-plus",
    "qwen3-max-2026-01-23",
    "qwen3-coder-plus",
    "qwen3-coder-next",
    "glm-5",
    "glm-4.7",
    "kimi-k2.5",
    "MiniMax-M2.5"
