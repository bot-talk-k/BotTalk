  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inject-time.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "Invoke-WebRequest -Uri 'https://bot-talk.com/b423b097c523d5dc76467cf3d67f4c23.send?title=Claude完成工作&desp=AI助手已完成一轮对话请查看' -UseBasicParsing -Method Get -TimeoutSec 5 -ErrorAction SilentlyContinue; [console]::beep(800,300)",
            "shell": "powershell"
          }
        ]
      }
    ]
  }
}
